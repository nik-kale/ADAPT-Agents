# ADAPT-Agents Configuration
# Copy this file to .env and fill in your values

# === LLM Settings ===
ADAPT_LLM_PROVIDER=openai  # openai, anthropic, azure, bedrock
ADAPT_LLM_MODEL=gpt-4
ADAPT_LLM_API_KEY=your-api-key-here
ADAPT_LLM_TEMPERATURE=0.0
ADAPT_LLM_MAX_TOKENS=4000

# === Cache Settings ===
ADAPT_ENABLE_CACHING=true
ADAPT_CACHE_BACKEND=memory  # memory, redis
ADAPT_CACHE_REDIS_URL=redis://localhost:6379
ADAPT_CACHE_TTL_SECONDS=300

# === Observability Settings ===
ADAPT_ENABLE_TRACING=true
ADAPT_ENABLE_METRICS=true
ADAPT_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
ADAPT_LOG_FORMAT=json  # json, text

# === OpenTelemetry Settings ===
ADAPT_OTEL_ENDPOINT=http://localhost:4317
ADAPT_OTEL_SERVICE_NAME=adapt-agents

# === API Settings ===
ADAPT_API_HOST=0.0.0.0
ADAPT_API_PORT=8000
ADAPT_API_WORKERS=4

# === Agent Settings ===
ADAPT_DEFAULT_TIMEOUT_SECONDS=30
ADAPT_MAX_RETRIES=3
ADAPT_LOG_ANALYZER_MAX_FINDINGS=10
ADAPT_METRICS_ANALYZER_ANOMALY_THRESHOLD=3.0
ADAPT_HYPOTHESIS_MAX_HYPOTHESES=5

# === Security Settings ===
ADAPT_ENABLE_PII_FILTERING=true
ADAPT_ENABLE_AUDIT_LOGGING=false

# === Performance Settings ===
ADAPT_MAX_PARALLEL_AGENTS=10
ADAPT_AGENT_POOL_SIZE=5
