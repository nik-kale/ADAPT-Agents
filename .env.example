# ADAPT-Agents Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════
# LLM CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# LLM Provider: "openai" or "anthropic"
ADAPT_LLM_PROVIDER=openai

# API Key for your chosen LLM provider
ADAPT_LLM_API_KEY=your-api-key-here

# Model to use
ADAPT_LLM_MODEL=gpt-4

# LLM Temperature (0.0 = deterministic, 1.0 = creative)
ADAPT_LLM_TEMPERATURE=0.0

# Maximum tokens for LLM responses
ADAPT_LLM_MAX_TOKENS=4000

# LLM request timeout in seconds
ADAPT_LLM_TIMEOUT_SECONDS=60

# ═══════════════════════════════════════════════════════════════
# CACHING CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Enable caching (true/false)
ADAPT_ENABLE_CACHING=true

# Cache backend: "memory" or "redis"
ADAPT_CACHE_BACKEND=redis

# Redis URL (only needed if cache_backend=redis)
ADAPT_CACHE_REDIS_URL=redis://localhost:6379

# Cache TTL in seconds
ADAPT_CACHE_TTL_SECONDS=300

# ═══════════════════════════════════════════════════════════════
# API SERVER SETTINGS
# ═══════════════════════════════════════════════════════════════

# API authentication key (set this to enable API key auth)
ADAPT_API_KEY=your-secret-api-key-here

# ═══════════════════════════════════════════════════════════════
# SECURITY SETTINGS
# ═══════════════════════════════════════════════════════════════

# Enable PII filtering
ADAPT_ENABLE_PII_FILTERING=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ADAPT_LOG_LEVEL=INFO
